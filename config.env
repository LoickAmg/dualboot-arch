# config.env — paramètres de l'installation (sourcé par lib/common.sh)
# Toute valeur "A_COMPLETER" bloque les scripts qui en ont besoin.
# Pour la répétition en VM : CONFIG_FILE=config.vm.env ./install/...

# --- Sécurité -------------------------------------------------------------
# 1 = affiche les commandes sans rien exécuter (défaut). 0 = exécution réelle.
# Ne JAMAIS passer DRY_RUN=0 ici : le donner sur la ligne de commande,
# script par script :  DRY_RUN=0 ./install/10-partition.sh create
DRY_RUN="${DRY_RUN:-1}"

# --- Disque ----------------------------------------------------------------
DISK="/dev/nvme0n1"            # disque unique Windows + Linux (à confirmer en phase 1)
ESP_SIZE_MIB=1024              # ESP Linux : 1 GiB
ROOT_SIZE_GIB=250              # racine Btrfs ; "MAX" = tout le bloc libre restant
ESP_PARTLABEL="ARCH-ESP"
ROOT_PARTLABEL="ARCH-ROOT"
ESP_FSLABEL="ARCHESP"          # FAT32 : 11 caractères max, majuscules
ROOT_FSLABEL="archroot"
ESP_DEV="/dev/disk/by-label/${ESP_FSLABEL}"
ROOT_DEV="/dev/disk/by-label/${ROOT_FSLABEL}"
MOUNT_OPTS="noatime,compress=zstd:1,discard=async"
TARGET="/mnt"

# Support externe (clé ou disque) monté : sauvegarde GPT, copie ESP Windows,
# rapports. Obligatoire avant 10-partition.sh create.
BACKUP_DIR="A_COMPLETER"       # ex. /run/media/ventoy/dualboot-backup ou /mnt/usb/backup

# --- Système ---------------------------------------------------------------
HOSTNAME_NEW="A_COMPLETER"     # nom de machine
USERNAME_NEW="A_COMPLETER"     # nom d'utilisateur (minuscules)
KEYMAP="A_COMPLETER"           # console : fr-latin9 / fr (AZERTY) / us ... à confirmer
XKB_LAYOUT="A_COMPLETER"       # Wayland : fr / us ...
TIMEZONE="Africa/Porto-Novo"   # à confirmer
LOCALES="fr_FR.UTF-8 en_US.UTF-8"
LANG_DEFAULT="fr_FR.UTF-8"

# --- Démarrage ---------------------------------------------------------------
BOOTLOADER_ID="ARCH-GRUB"
MKINIT_HOOKS="base udev autodetect microcode modconf kms keyboard keymap consolefont block filesystems grub-btrfs-overlayfs"

# --- Paquets -----------------------------------------------------------------
BASE_PACKAGES="base linux linux-lts linux-firmware intel-ucode btrfs-progs grub efibootmgr os-prober networkmanager sudo git base-devel neovim snapper snap-pac grub-btrfs inotify-tools zram-generator openssh man-db"
