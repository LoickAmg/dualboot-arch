# config.vm.env — surcharge pour la répétition en VM (phase 0)
# Usage : CONFIG_FILE=./config.vm.env ./install/00-preflight-live.sh
# shellcheck disable=SC1091
. "$(dirname "${CONFIG_FILE}")/config.env"

ROOT_SIZE_GIB=60
BACKUP_DIR="/root/vm-backup"     # dans la VM, la RAM de la live suffit
HOSTNAME_NEW="arch-vm"
USERNAME_NEW="testeur"
KEYMAP="fr-latin9"
XKB_LAYOUT="fr"
